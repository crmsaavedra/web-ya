
/* --- RESTORED MODAL STYLES --- */
.m-desc {
    color: #ccc;
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 25px;
    border-left: 2px solid var(--primary);
    padding-left: 15px;
}

.m-tech {
    margin-top: 25px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.85rem;
    color: #888;
    letter-spacing: 0.5px;
    font-family: monospace;
}

.m-tech span {
    color: var(--primary);
    font-weight: 700;
    text-transform: uppercase;
    margin-right: 5px;
    font-family: 'Inter', sans-serif;
}
